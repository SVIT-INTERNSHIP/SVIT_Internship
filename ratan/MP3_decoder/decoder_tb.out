#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x59cfd091a0d0 .scope module, "decoder_tb" "decoder_tb" 2 1;
 .timescale 0 0;
v0x59cfd092d500_0 .var "a", 0 0;
v0x59cfd092d5d0_0 .var "b", 0 0;
v0x59cfd092d6a0_0 .net "y", 3 0, v0x59cfd092d3c0_0;  1 drivers
S_0x59cfd091a260 .scope module, "uut" "decoder" 2 4, 3 1 0, S_0x59cfd091a0d0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 4 "y";
v0x59cfd08e0490_0 .net "a", 0 0, v0x59cfd092d500_0;  1 drivers
v0x59cfd092d300_0 .net "b", 0 0, v0x59cfd092d5d0_0;  1 drivers
v0x59cfd092d3c0_0 .var "y", 3 0;
E_0x59cfd08e0f10 .event anyedge, v0x59cfd08e0490_0, v0x59cfd092d300_0;
    .scope S_0x59cfd091a260;
T_0 ;
    %wait E_0x59cfd08e0f10;
    %load/vec4 v0x59cfd08e0490_0;
    %load/vec4 v0x59cfd092d300_0;
    %concat/vec4; draw_concat_vec4
    %dup/vec4;
    %pushi/vec4 0, 0, 2;
    %cmp/u;
    %jmp/1 T_0.0, 6;
    %dup/vec4;
    %pushi/vec4 1, 0, 2;
    %cmp/u;
    %jmp/1 T_0.1, 6;
    %dup/vec4;
    %pushi/vec4 2, 0, 2;
    %cmp/u;
    %jmp/1 T_0.2, 6;
    %dup/vec4;
    %pushi/vec4 3, 0, 2;
    %cmp/u;
    %jmp/1 T_0.3, 6;
    %jmp T_0.4;
T_0.0 ;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x59cfd092d3c0_0, 0, 4;
    %jmp T_0.4;
T_0.1 ;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x59cfd092d3c0_0, 0, 4;
    %jmp T_0.4;
T_0.2 ;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x59cfd092d3c0_0, 0, 4;
    %jmp T_0.4;
T_0.3 ;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x59cfd092d3c0_0, 0, 4;
    %jmp T_0.4;
T_0.4 ;
    %pop/vec4 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x59cfd091a0d0;
T_1 ;
    %vpi_call 2 6 "$dumpfile", "decoder.vcd" {0 0 0};
    %vpi_call 2 7 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x59cfd091a0d0 {0 0 0};
    %vpi_call 2 8 "$monitor", "Time=%0t a=%b b=%b y=%b", $time, v0x59cfd092d500_0, v0x59cfd092d5d0_0, v0x59cfd092d6a0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59cfd092d500_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59cfd092d5d0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59cfd092d500_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x59cfd092d5d0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x59cfd092d500_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59cfd092d5d0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x59cfd092d500_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x59cfd092d5d0_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 13 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "decoder_tb.v";
    "decoder.v";
