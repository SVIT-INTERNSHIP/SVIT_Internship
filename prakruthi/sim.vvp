    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58aad9711280_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58aad9711350_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x58aad9711350_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 12 "$finish" {0 0 0};
